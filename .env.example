# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SESSION_SECRET: Secret used to sign session cookies (auto-generated fallback used in development).
SESSION_SECRET="CHANGE_ME_IN_PRODUCTION"

# OPTIONAL: If enabling Google Maps JavaScript API in the future:
# VITE_GOOGLE_MAPS_API_KEY="YOUR_GOOGLE_MAPS_API_KEY"

# OPTIONAL: If enabling Firebase Authentication / Firestore in the future:
# VITE_FIREBASE_API_KEY=""
# VITE_FIREBASE_AUTH_DOMAIN=""
# VITE_FIREBASE_PROJECT_ID=""
# VITE_FIREBASE_STORAGE_BUCKET=""
# VITE_FIREBASE_APP_ID=""
